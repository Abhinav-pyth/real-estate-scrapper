2:["$","div",null,{"className":"prose-sm mx-auto max-w-3xl space-y-6","children":[["$","h1",null,{"className":"text-2xl font-bold","children":"How Indore Property Finder collects data"}],["$","section",null,{"className":"card space-y-2 p-5 text-sm leading-relaxed text-slate-700","children":[["$","h2",null,{"className":"text-lg font-bold text-slate-900","children":"Our rules"}],["$","ul",null,{"className":"list-disc space-y-1 pl-5","children":[["$","li",null,{"children":"We check each source's robots.txt, terms of service and technical access controls before collecting anything."}],["$","li",null,{"children":["We ",["$","b",null,{"children":"never"}]," bypass CAPTCHAs, logins, paywalls or anti-bot systems."]}],["$","li",null,{"children":"Where automated collection is not permitted, the connector stays disabled and is marked honestly below."}],["$","li",null,{"children":"We prefer official APIs, licensed feeds, partner integrations and explicitly authorized scraping."}],["$","li",null,{"children":"Administrators can import datasets from providers who hold the rights (CSV/JSON), with full validation."}],["$","li",null,{"children":"We never fabricate listings, prices, URLs or coordinates. Missing data is shown as “not available”."}],["$","li",null,{"children":"Personal contact details are not collected or republished."}],["$","li",null,{"children":"Listings that a source asks us to remove are taken down promptly (see takedown section)."}]]}]]}],["$","section",null,{"className":"card space-y-3 p-5","children":[["$","h2",null,{"className":"text-lg font-bold","children":"Source connectors — live status"}],["$","p",null,{"className":"text-sm text-slate-600","children":"Statuses come directly from the database and reflect actual configuration — nothing is pretended to work."}],["$","table",null,{"className":"w-full text-left text-xs","children":[["$","thead",null,{"children":["$","tr",null,{"className":"border-b border-slate-200 text-slate-500","children":[["$","th",null,{"c