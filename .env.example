# ── Indore Property Finder — environment template ─────────────────────────────
# Copy to .env (local dev) and set these in Vercel project settings (production).

# REQUIRED — PostgreSQL connection string.
# Vercel: create a Vercel Postgres / Neon / Supabase database and paste its pooled URL.
# Use the POOLED connection string on Vercel (serverless functions open many short-lived connections).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ipf?sslmode=require"

# REQUIRED in production — 32+ random chars, signs session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-hex-string"

# REQUIRED in production — canonical site URL (used for SEO metadata, sitemap, OG tags)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Admin bootstrap (prisma/seed.ts creates this user if missing). CHANGE BOTH in production.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin"

# OPTIONAL — authorized partner feed/API connector (the ONLY automated network source by default policy).
# Must be a JSON endpoint YOU have explicit permission to consume, returning { "listings": [...] }
# with Indore-scoped records. Never point this at sites that prohibit automated collection.
AUTHORIZED_FEED_URL=""
AUTHORIZED_FEED_TOKEN=""

# OPTIONAL — Redis + BullMQ for the background worker (deploy worker separately; not on Vercel serverless).
REDIS_URL=""

# OPTIONAL — Google Maps (app works fully WITHOUT it using Leaflet + OpenStreetMap).
# Public key (map display): restrict to your domains via Google Cloud console. Billing must be enabled.
NEXT_PUBLIC_MAP_PROVIDER="osm"   # "osm" | "google"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server-side geocoding key: restrict to Geocoding API only; NEVER expose publicly.
GOOGLE_GEOCODING_API_KEY=""

# OPTIONAL — geocoder identification (Nominatim usage policy asks for a contact UA at high volume)
GEOCODER_UA="indore-property-finder/1.0 (set-your-contact@example.com)"

# OPTIONAL — API rate limiting & uploads
API_RATE_LIMIT_MAX=120
MAX_CSV_BYTES=2000000

# OPTIONAL — AdSense placeholder (renders NOTHING until you set a real approved client id)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
